# Supabase client/public configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Supabase server configuration
SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI/provider integrations
AI_PROVIDER=openai-compatible
AI_OPENAI_COMPATIBLE_BASE_URL=your_openai_compatible_chat_completions_url
AI_OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key

# Email/digest integrations
DIGEST_SECRET=your_digest_secret
RESEND_API_KEY=your_resend_api_key

# Billing
STRIPE_SECRET_KEY=your_stripe_secret_key

# Optional feature flags
VITE_SHOW_DEPRECATED_ASSESSMENT_FIELDS=false
VITE_MEASUREMENT_LEGACY_REASSESSMENT_SHEET=false
